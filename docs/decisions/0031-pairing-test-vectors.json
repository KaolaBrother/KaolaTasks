  "fail_closed_assertions": [
    {
      "id": "wrong_secret",
      "expect": "bind rejects; devices.status stays pending; no approval proof; no v2 trust write"
    },
    {
      "id": "field_substitution",
      "expect": "any one-byte XOR of a transcript field yields the listed commitment, never the primary commitment; client and server fail closed"
    },
    {
      "id": "root_substitution",
      "expect": "proof bound to a different root_ca_sha256 must not install that PEM"
    },
    {
      "id": "instance_or_origin_mismatch",
      "expect": "descriptor or proof that disagrees with --url / PUBLIC_URL origin or persisted instance_id must not write ready trust"
    },
    {
      "id": "device_mismatch",
      "expect": "proof for another device fingerprint must not activate this device.json"
    },
    {
      "id": "expired_attempt",
      "expect": "status expired; bind 409 pairing_expired; no ready trust. now >= pairing.expires_at only; created_at+1 and expires_at-1 still succeed"
    },
    {
      "id": "lifetime_not_900s",
      "expect": "no 900/300-3600 pairing wait; receipt and proof usable for the full >=86400s window from this create"
    },
    {
      "id": "existing_pending_alignment",
      "expect": "device already pending with remaining < 24h: new pair expires_at = now+ttl (>=86400); pending_expires_at = max(old, pairing.expires_at); recover does not slide"
    },
    {
      "id": "post_bind_device_max_age_independent",
      "expect": "after approve, devices.expires_at uses owner device_max_age_days default 90, not pairing TTL; stored 30 and existing expires_at are not rewritten"
    },
    {
      "id": "replay_approval",
      "expect": "consumed pairing does not re-issue proof; a second device cannot consume it"
    },
    {
      "id": "non_admin_bind",
      "expect": "publisher session 403 forbidden; pending remains pending"
    },
    {
      "id": "bootstrap_cannot_claim",
      "expect": "pairing REST never lists tasks, never returns forge token, never reaches /api/mcp"
    },
    {
      "id": "hostname_mismatch_no_bootstrap",
      "expect": "ERR_TLS_CERT_ALTNAME_INVALID and expired/not-yet-valid certs do not enter bootstrap"
    },
    {
      "id": "public_ca_no_extra_root",
      "expect": "default-store success must not install a private root"
    },
    {
      "id": "v1_not_v2",
      "expect": "legacy $KAOLA_HOME/trust/state.json v:1 is never rewritten as v2 and never claims approval-bound pairing"
    }
  ]
}
