{
  "comment": "Issue #63 / ADR 0031 frozen oracles. Synthetic only: example.test origin, sequential nonces, no live host, no PEM, no private key. Implementation tests MUST import this file and MUST NOT re-derive a different transcript encoding.",
  "encoding": {
    "transcript_fields_in_order": [
      "protocol_version",
      "pairing_id",
      "instance_id",
      "origin",
      "device_fingerprint",
      "client_nonce",
      "server_nonce",
      "root_ca_sha256",
      "expires_at"
    ],
    "approval_fields_in_order": [
      "protocol_version",
      "pairing_id",
      "instance_id",
      "origin",
      "device_fingerprint",
      "root_ca_sha256",
      "owner_kind",
      "owner_id",
      "approved_at",
      "expires_at"
    ],
    "field": "uint32be(length) || bytes",
    "max_field_length": 65536,
    "utf8_fields": [
      "protocol_version",
      "pairing_id",
      "instance_id",
      "origin",
      "device_fingerprint",
      "expires_at",
      "owner_kind",
      "owner_id",
      "approved_at"
    ],
    "raw_32_byte_fields": ["client_nonce", "server_nonce", "root_ca_sha256"],
    "commitment": "HMAC-SHA256(pairing_secret, SHA-256(transcript))",
    "hkdf": {
      "hash": "sha256",
      "ikm": "pairing_secret",
      "salt": "SHA-256(transcript)",
      "info_utf8": "kaola-pairing-approval-v1",
      "length": 32
    },
    "proof": "HMAC-SHA256(pairing_key, SHA-256(approval_transcript))",
    "root_ca_sha256": "SHA-256 of the single certificate DER, not PEM text",
    "device_fingerprint": "SHA-256 of Ed25519 SPKI DER as 64 lowercase hex, UTF-8 in the transcript",
    "origin": "WHATWG URL origin: protocol + '//' + host, trailing slash stripped; same string hashed by apps/mcp originDigest",
    "unix_seconds": "decimal ASCII with no sign and no leading zeros; zero is the single character 0",
    "pairing_secret_wire": "16+ bytes; admin bind accepts lowercase hex with optional dashes/spaces/colons",
    "attempt_lifetime": {
      "default_ttl_seconds": 86400,
      "minimum_ttl_seconds": 86400,
      "maximum_ttl_seconds": 604800,
      "live_while": "now < expires_at",
      "expired_when": "now >= expires_at",
      "window_starts_at": "this pairing create, not leftover pending first-seen",
      "idempotent_recover_slides_expires_at": false,
      "pending_extended_never_shortened": true,
      "post_bind_device_max_age_days_default": 90,
      "vector_expires_at_note": "vectors[].expires_at is a synthetic absolute unix time for transcript bytes; it is not a 900-second TTL"
    }
  },
